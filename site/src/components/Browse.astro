---
import { PAGE_SIZE, pageCount, pagerHtml, SORT_LABELS, type SortKey } from '../lib/browse';
import { CATEGORY_LABELS, formatCount, SUBCATEGORIES, SUBCATEGORY_LABELS } from '../lib/labels';
import type { Category, Skill, Subcategory } from '../lib/types';
import AdSlot from './AdSlot.astro';
import SkillItem from './SkillItem.astro';

interface Props {
  skills: Skill[];
  emptyTitle: string;
  emptyBody: string;
  defaultSort?: SortKey;
  dateKind?: 'updated' | 'found';
  catalogUrl?: string;
}

const { skills, emptyTitle, emptyBody, defaultSort = 'rank', dateKind, catalogUrl = '/catalog.json' } = Astro.props;
const counts = new Map<Category, number>();
for (const skill of skills) counts.set(skill.category, (counts.get(skill.category) ?? 0) + 1);
const categories = (Object.keys(CATEGORY_LABELS) as Category[]).filter((category) => counts.has(category));
const subCounts = new Map<Subcategory, number>();
for (const { subcategory } of skills) {
  if (subcategory) subCounts.set(subcategory, (subCounts.get(subcategory) ?? 0) + 1);
}
// 세부 분류가 둘 이상 있는 대분류만 칩 줄을 둔다. 하나뿐이면 고를 것이 없다.
const subGroups = categories
  .map((category) => ({ category, subs: SUBCATEGORIES[category].filter((sub) => subCounts.has(sub)) }))
  .filter(({ subs }) => subs.length > 1);
const sorts = (Object.entries(SORT_LABELS) as [SortKey, string][])
  .filter(([value]) => value !== 'new' || dateKind === 'found');
const pager = pagerHtml(1, pageCount(skills.length), (page) => `?page=${page}`);
---

<div
  class="browse"
  data-browse
  data-categories={categories.join(',')}
  data-default-sort={defaultSort}
  data-date-kind={dateKind ?? 'updated'}
  data-catalog={catalogUrl}
  data-total={skills.length}
>
  {skills.length > 0 && (
    <div class="toolbar">
      <label>
        <span class="visually-hidden">스킬 검색</span>
        <input class="search" type="search" name="q" placeholder="이름, 용도, 저장소로 찾기" autocomplete="off" />
      </label>
      <button class="button filter-open" type="button" data-filters-open aria-haspopup="dialog">필터</button>
    </div>

    <dialog class="filter-sheet" data-filters aria-label="필터">
      <div class="filters__head">
        <h2>필터</h2>
        <button class="button" type="button" data-filters-close>닫기</button>
      </div>
      <div data-sheet-slot></div>
      <div class="filters__foot">
        <button class="button" type="button" data-reset hidden>초기화</button>
        <button class="button button--primary" type="button" data-filters-apply>스킬 보기</button>
      </div>
    </dialog>

    <div class="filters" role="group" aria-label="필터" data-filter-controls>
    <fieldset>
      <legend>카테고리</legend>
      <div class="chips">
        <label class="option option--cat" data-cat="all">
          <input type="radio" name="category" value="" checked />
          <span>전체 <small>{formatCount(skills.length)}</small></span>
        </label>
        {categories.map((category) => (
          <label class="option option--cat" data-cat={category}>
            <input type="radio" name="category" value={category} />
            <span>{CATEGORY_LABELS[category]} <small>{formatCount(counts.get(category) ?? 0)}</small></span>
          </label>
        ))}
      </div>
    </fieldset>
    {subGroups.map(({ category, subs }) => (
      <fieldset class="subfilter" data-sub-for={category} hidden>
        <legend>{CATEGORY_LABELS[category]} 세부 분류</legend>
        <div class="chips">
          <label class="option">
            <input type="radio" name={`sub-${category}`} value="" checked />
            <span>{CATEGORY_LABELS[category]} 전체</span>
          </label>
          {subs.map((sub) => (
            <label class="option">
              <input type="radio" name={`sub-${category}`} value={sub} />
              <span>{SUBCATEGORY_LABELS[sub]} <small>{subCounts.get(sub)}</small></span>
            </label>
          ))}
        </div>
      </fieldset>
    ))}
    <fieldset>
      <legend>AI 판단</legend>
      <label class="choice">
        <input type="checkbox" name="local" />
        <span class="choice__label">코드 실행·네트워크가 확인되지 않은 스킬만</span>
      </label>
      <label class="choice">
        <input type="checkbox" name="no-account" />
        <span class="choice__label">외부 계정이 확인되지 않은 스킬만</span>
      </label>
      <p class="filters__hint">AI가 SKILL.md에서 찾지 못했다는 뜻입니다. 없다는 보장은 아닙니다.</p>
    </fieldset>
    </div>
  )}

  <div class="browse__main">
    {skills.length > 0 && (
      <div class="result-bar">
        <p role="status"><b data-count>{formatCount(skills.length)}개 스킬</b></p>
        <div class="result-bar__controls">
          <button class="text-button" type="button" data-reset hidden>초기화</button>
          <label>
            <span class="visually-hidden">정렬</span>
            <select class="select" name="sort">
              {sorts.map(([value, label]) => <option {value} selected={value === defaultSort}>{label}</option>)}
            </select>
          </label>
          <div class="segmented" role="group" aria-label="보기 방식">
            <button type="button" data-view="table" aria-pressed="true">목록</button>
            <button type="button" data-view="cards" aria-pressed="false">카드</button>
          </div>
        </div>
      </div>
    )}
    <h2 class="visually-hidden">스킬 목록</h2>
    <ol class="skill-list" data-list data-view="table">
      <li class="table-head" aria-hidden="true">
        <span>AI 판단</span><span>{dateKind === 'found' ? '발견일' : '업데이트'}</span><span>저장소 스타</span>
      </li>
      {skills.slice(0, PAGE_SIZE).map((skill) => <SkillItem skill={skill} dateKind={dateKind} />)}
    </ol>
    <nav class="pager" aria-label="목록 쪽 번호" data-pager><Fragment set:html={pager} /></nav>
    <noscript><style>.pager { display: none !important; }</style></noscript>
    <p class="load-error" data-load-error hidden>
      목록을 불러오지 못했습니다.
      <button class="text-button" type="button" data-retry>다시 시도</button>
    </p>
    <div class="empty" data-empty hidden={skills.length > 0}>
      <strong>{skills.length > 0 ? '조건에 맞는 스킬이 없습니다' : emptyTitle}</strong>
      <p>{skills.length > 0 ? '검색어를 줄이거나 필터를 해제해 보세요.' : emptyBody}</p>
      {skills.length > 0 && (
        <div class="empty__actions">
          <button class="button" type="button" data-reset>초기화</button>
          <a class="button" href="/ask/">AI 찾기로 문장으로 찾기</a>
        </div>
      )}
    </div>
    <AdSlot />
  </div>
</div>

<script>
  import '../scripts/browse';
</script>
