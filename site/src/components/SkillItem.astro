---
import { toCatalogItem } from '../lib/catalog';
import { skillRowHtml } from '../lib/skill-row';
import type { Skill } from '../lib/types';

interface Props {
  skill: Skill;
  dateKind?: 'updated' | 'found';
}

const { skill, dateKind } = Astro.props;
---

<Fragment set:html={skillRowHtml(toCatalogItem(skill), { dateKind })} />
