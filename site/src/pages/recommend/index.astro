---
import SkillResults from '../../components/SkillResults.astro';
import Layout from '../../layouts/Layout.astro';
import { INSTALL_TARGETS } from '../../lib/install';
import { skills } from '../../lib/data';
import { DIFFICULTY_LABELS, ROLE_LABELS } from '../../lib/labels';
import { GOALS } from '../../lib/questionnaire';

const anyAnswer = { value: '', label: '상관없음' };
const questions = [
  {
    name: 'goal',
    title: '무엇을 하고 싶으신가요?',
    options: GOALS.map(({ id, label }) => ({ value: id, label })),
  },
  {
    name: 'role',
    title: '어떤 일을 하시나요?',
    options: [
      ...Object.entries(ROLE_LABELS).map(([value, label]) => ({ value, label: value === 'general' ? '기타' : label })),
      anyAnswer,
    ],
  },
  {
    name: 'level',
    title: '어느 정도 난이도가 편한가요?',
    options: [...Object.entries(DIFFICULTY_LABELS).map(([value, label]) => ({ value, label })), anyAnswer],
  },
  {
    name: 'tool',
    title: '어떤 도구에 설치하시나요?',
    options: INSTALL_TARGETS.map(({ id, label }) => ({ value: id, label })),
  },
];
---

<Layout title="맞춤 추천" description="직군과 하고 싶은 일을 고르면 맞는 AI 에이전트 스킬을 추천합니다.">
  <section class="lede">
    <h1>맞춤 추천</h1>
    <p>네 가지 질문 중 고를 수 있는 것만 답하세요.{skills.length > 0 && <> 문장으로 찾으려면 <a href="/ask/">AI 찾기</a>를 이용하세요.</>}</p>
  </section>

  <div class="recommend">
    <form class="panel" data-questionnaire>
      <h2 class="visually-hidden">네 가지 질문</h2>
      <p>답변은 브라우저 안에서만 계산하고 서버로 보내지 않습니다.</p>
      {questions.map(({ name, title, options }) => (
        <fieldset class="question">
          <legend>{title}</legend>
          <div class="options">
            {options.map(({ value, label }) => (
              <label class="option">
                <input type="radio" {name} {value} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <button class="button button--primary" type="submit">추천 받기</button>
      <p class="status" role="status" data-result-status></p>
    </form>
  </div>

  <SkillResults>
    <button class="button" type="button" data-share>결과 링크 복사</button>
  </SkillResults>
</Layout>

<script>
  import '../../scripts/recommend';
</script>
