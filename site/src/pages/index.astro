---
import Browse from '../components/Browse.astro';
import Layout from '../layouts/Layout.astro';
import { skills } from '../lib/data';
import { SITE_NAME } from '../lib/labels';

const description = 'Claude Code, Codex, Cursor에서 쓰는 AI 에이전트 스킬을 한국어로 정리하고 추천합니다.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: Astro.site?.href,
  inLanguage: 'ko',
};
---

<Layout title={SITE_NAME} {description} {structuredData}>
  <section class="lede">
    <h1>에이전트에게 맡길 일, 스킬로 찾아보세요</h1>
    <p>GitHub의 SKILL.md 스킬을 한국어로 정리했습니다. 무엇을 해 주는지, 언제 쓰는지, 코드를 실행하는지 설치 전에 확인할 수 있습니다.</p>
  </section>
  <Browse
    {skills}
    emptyTitle="아직 공개된 스킬이 없습니다"
    emptyBody="첫 수집이 끝나면 이곳에 스킬이 나타납니다."
  />
</Layout>
