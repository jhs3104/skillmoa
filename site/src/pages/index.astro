---
import Browse from '../components/Browse.astro';
import HomeGuide from '../components/HomeGuide.astro';
import Layout from '../layouts/Layout.astro';
import { skills } from '../lib/data';
import { SITE_NAME } from '../lib/labels';

const description = 'GitHub에 공개된 AI 에이전트 스킬을 한국어로 정리한 AI 스킬 모음입니다. Claude Code, Codex, Cursor에 설치해 쓸 스킬을 검색하고 추천받으세요.';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: Astro.site?.href,
  inLanguage: 'ko',
};
---

<Layout title={SITE_NAME} {description} {structuredData}>
  <div class="home">
    <section class="hero">
      <h1>{skills.length > 0 ? <>AI 에이전트 스킬을<br />한국어로 찾아보세요</> : 'AI 에이전트 스킬을 모으고 있습니다'}</h1>
      {skills.length > 0 ? (
        <p class="hero__lead">GitHub에 공개된 AI 에이전트 스킬을 한국어로 정리했습니다. Claude Code, Codex, Cursor에 설치해 쓸 수 있습니다. <a href="#guide">처음이라면 설치 전 안내 보기</a></p>
      ) : (
        <p class="hero__lead">GitHub의 AI 에이전트 스킬을 한국어로 정리하고 있습니다. 첫 수집이 끝나면 찾을 수 있습니다.</p>
      )}
    </section>
    <Browse
      {skills}
      emptyTitle="아직 공개된 스킬이 없습니다"
      emptyBody="첫 수집이 끝나면 이곳에 스킬이 나타납니다."
    />
    <HomeGuide />
  </div>
</Layout>
