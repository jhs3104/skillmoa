---
import Browse from '../../components/Browse.astro';
import Layout from '../../layouts/Layout.astro';
import { freshSkills } from '../../lib/data';
import { NEW_SKILL_DAYS } from '../../lib/freshness';

const fresh = freshSkills();
---

<Layout
  title="새로 발견한 스킬"
  description={`최근 ${NEW_SKILL_DAYS}일 안에 발견된 AI 에이전트 스킬을 모았습니다.`}
>
  <section class="lede">
    <h1>새로 발견한 스킬</h1>
    <p>최근 {NEW_SKILL_DAYS}일 안에 처음 발견한 스킬입니다. 매일 갱신됩니다.</p>
  </section>
  <Browse
    skills={fresh}
    emptyTitle={`최근 ${NEW_SKILL_DAYS}일 안에 발견한 스킬이 없습니다`}
    emptyBody="새 스킬을 찾으면 이곳에 표시합니다."
    defaultSort="new"
    dateKind="found"
    catalogUrl="/catalog-new.json"
  />
</Layout>
