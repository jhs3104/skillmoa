---
import AdSlot from '../../components/AdSlot.astro';
import CategoryLabel from '../../components/CategoryLabel.astro';
import InstallGuide from '../../components/InstallGuide.astro';
import SkillItem from '../../components/SkillItem.astro';
import Star from '../../components/Star.astro';
import Layout from '../../layouts/Layout.astro';
import { repositoryUrl, skillFolderUrl, skills, sourceUrl } from '../../lib/data';
import {
  CATEGORY_LABELS,
  DIFFICULTY_LABELS,
  formatDate,
  formatLicense,
  formatStars,
  ROLE_LABELS,
  SUBCATEGORY_LABELS,
} from '../../lib/labels';
import { licenseNotice, licenseStatus } from '../../lib/license';
import { isIndexable, truncate } from '../../lib/seo';
import type { Skill } from '../../lib/types';

export function getStaticPaths() {
  return skills.map((skill) => ({ params: { slug: skill.slug }, props: { skill } }));
}

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const related = skills
  .filter((other) => other.category === skill.category && other.slug !== skill.slug)
  .slice(0, 4);
const risks = [
  skill.runsExternalCode ? '스크립트·프로그램 실행' : '',
  skill.accessesNetwork ? '외부 네트워크 접속' : '',
].filter(Boolean);
const category = CATEGORY_LABELS[skill.category];
const licenseWarning = licenseNotice(skill.license);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: skill.name,
  description: skill.summary,
  codeRepository: repositoryUrl(skill),
  inLanguage: 'ko',
  ...(skill.license ? { license: skill.license } : {}),
};
const SCRIPT_FILE_LABELS = {
  none: '없음, 지침 문서만 있음',
  present: '있음',
  unknown: '폴더를 확인하지 못함',
} as const;
---

<Layout
  title={`${skill.name} 스킬`}
  description={truncate(skill.summary, 150)}
  noindex={!isIndexable(skill)}
  {structuredData}
>
  <div class="detail">
    <nav class="crumb" aria-label="현재 위치">
      <a href="/">전체 스킬</a><span aria-hidden="true">/</span>
      <a href={`/?category=${skill.category}`}>{category}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{skill.name}</span>
    </nav>

    <header class="detail__head">
      <h1>{skill.name}</h1>
      <p class="detail__source">
        <CategoryLabel category={skill.category} />
        {skill.subcategory && <span class="detail__sub">{SUBCATEGORY_LABELS[skill.subcategory]}</span>}
        {skill.repository}
      </p>
    </header>

    <section class="detail__about">
      <p class="detail__summary">{skill.summary}</p>
      <p class="detail__when"><b>이럴 때 쓰세요</b> {skill.useWhen}</p>
      <div class="tag-row">
        {skill.tags.useCases.map((useCase) => <span class="badge">{useCase}</span>)}
      </div>
      <div class="detail__links">
        <a class="button button--primary" href={repositoryUrl(skill)} rel="noopener noreferrer">GitHub에서 보기</a>
        <a class="button" href={sourceUrl(skill)} rel="noopener noreferrer">SKILL.md 원문</a>
      </div>
    </section>

    <section class="evidence" aria-labelledby="evidence-title">
      <h2 id="evidence-title">설치 전에 확인하세요</h2>
      {risks.length > 0 && (
        <p class="notice">AI가 SKILL.md에서 {risks.join('과 ')} 내용을 찾았습니다. 설치 전에 <a href={sourceUrl(skill)} rel="noopener noreferrer">원문</a>을 확인하세요.</p>
      )}
      {skill.requiresExternalAccount && (
        <p class="notice">AI가 SKILL.md에서 외부 서비스의 계정이나 API 키가 필요하다는 내용을 찾았습니다. 비용은 해당 서비스에서 확인하세요.</p>
      )}
      <div class="evidence__groups">
        <div>
          <h3>GitHub 기록</h3>
          <dl class="facts">
            <dt>저장소 스타</dt>
            <dd class="facts__stars"><Star />{formatStars(skill.stars)}</dd>
            <dt>저장소 업데이트</dt>
            <dd>{formatDate(skill.pushedAt)}</dd>
            <dt>라이선스</dt>
            <dd>{formatLicense(skill.license)}</dd>
            <dt>SKILL.md 경로</dt>
            <dd>{skill.path}</dd>
            <dt>스크립트 파일</dt>
            <dd>{SCRIPT_FILE_LABELS[skill.scriptFiles]}</dd>
          </dl>
        </div>
        <div>
          <h3>AI가 SKILL.md를 읽고 판단</h3>
          <dl class="facts">
            <dt>코드 실행</dt>
            <dd>{skill.runsExternalCode ? '있음' : '확인되지 않음'}</dd>
            <dt>네트워크 접속</dt>
            <dd>{skill.accessesNetwork ? '있음' : '확인되지 않음'}</dd>
            <dt>계정·API 키</dt>
            <dd>{skill.requiresExternalAccount ? '필요' : '확인되지 않음'}</dd>
            <dt>난이도</dt>
            <dd>{DIFFICULTY_LABELS[skill.tags.difficulty]}</dd>
            <dt>직군</dt>
            <dd>{skill.tags.roles.map((role) => ROLE_LABELS[role]).join(', ')}</dd>
          </dl>
        </div>
      </div>
      <p class="evidence__note">확인되지 않음은 AI가 SKILL.md에서 찾지 못했다는 뜻입니다. 없다는 보장은 아닙니다.</p>
    </section>

    <section class="section">
      <h2>설치</h2>
      {licenseWarning && (
        <p class="notice notice--install">{licenseWarning} <a href={skillFolderUrl(skill)} rel="noopener noreferrer">스킬 폴더 보기</a></p>
      )}
      {licenseStatus(skill.license) !== 'restricted' && (
        <InstallGuide repository={skill.repository} path={skill.path} />
      )}
    </section>

    {related.length > 0 && (
      <section class="section">
        <h2>같은 분류의 스킬</h2>
        <ol class="skill-list skill-list--plain" data-view="table">
          {related.map((other) => <SkillItem skill={other} />)}
        </ol>
      </section>
    )}
    <AdSlot />
  </div>
</Layout>
