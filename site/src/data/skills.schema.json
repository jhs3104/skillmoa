{
  "$defs": {
    "Category": {
      "enum": [
        "development",
        "testing",
        "devops",
        "data",
        "documents",
        "design",
        "writing",
        "marketing",
        "productivity",
        "research",
        "security",
        "ai-agents",
        "finance",
        "audio",
        "legal",
        "health-lifestyle",
        "other"
      ],
      "title": "Category",
      "type": "string"
    },
    "Difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "Role": {
      "description": "추천 질문의 직군 선택지와 같은 어휘를 쓴다.",
      "enum": [
        "developer",
        "designer",
        "data",
        "product",
        "marketer",
        "writer",
        "researcher",
        "general"
      ],
      "title": "Role",
      "type": "string"
    },
    "SiteRepository": {
      "properties": {
        "defaultBranch": {
          "title": "Defaultbranch",
          "type": "string"
        },
        "fullName": {
          "title": "Fullname",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "License"
        },
        "pushedAt": {
          "format": "date",
          "title": "Pushedat",
          "type": "string"
        },
        "stars": {
          "title": "Stars",
          "type": "integer"
        }
      },
      "required": [
        "fullName",
        "stars",
        "pushedAt",
        "license",
        "defaultBranch"
      ],
      "title": "SiteRepository",
      "type": "object"
    },
    "SiteSkill": {
      "properties": {
        "accessesNetwork": {
          "title": "Accessesnetwork",
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "firstSeenAt": {
          "format": "date",
          "title": "Firstseenat",
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "License"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "promptVersion": {
          "title": "Promptversion",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "requiresExternalAccount": {
          "title": "Requiresexternalaccount",
          "type": "boolean"
        },
        "runsExternalCode": {
          "title": "Runsexternalcode",
          "type": "boolean"
        },
        "scriptFiles": {
          "enum": [
            "none",
            "present",
            "unknown"
          ],
          "title": "Scriptfiles",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "subcategory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Subcategory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/SiteTags"
        },
        "useWhen": {
          "title": "Usewhen",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "rank",
        "name",
        "repository",
        "path",
        "license",
        "firstSeenAt",
        "summary",
        "useWhen",
        "category",
        "tags",
        "runsExternalCode",
        "accessesNetwork",
        "requiresExternalAccount",
        "scriptFiles",
        "promptVersion"
      ],
      "title": "SiteSkill",
      "type": "object"
    },
    "SiteTags": {
      "properties": {
        "difficulty": {
          "$ref": "#/$defs/Difficulty"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/Role"
          },
          "title": "Roles",
          "type": "array"
        },
        "useCases": {
          "items": {
            "type": "string"
          },
          "title": "Usecases",
          "type": "array"
        }
      },
      "required": [
        "roles",
        "useCases",
        "difficulty"
      ],
      "title": "SiteTags",
      "type": "object"
    },
    "Subcategory": {
      "description": "대분류 아래의 세부 분류. 모델은 이것만 고르고 대분류는 SUBCATEGORY_PARENT로 정한다.",
      "enum": [
        "frontend",
        "backend",
        "mobile",
        "git",
        "code-quality",
        "debugging",
        "dev-tools",
        "game-dev",
        "web3",
        "test-writing",
        "browser-testing",
        "qa",
        "deployment",
        "infrastructure",
        "monitoring",
        "release",
        "data-analysis",
        "database",
        "machine-learning",
        "visualization",
        "pdf",
        "office",
        "presentation",
        "diagram",
        "ui-ux",
        "visual-design",
        "image",
        "video",
        "accessibility",
        "drafting",
        "translation",
        "editing",
        "seo",
        "social-media",
        "advertising",
        "sales",
        "ecommerce",
        "communication",
        "notes-calendar",
        "project-management",
        "automation",
        "learning",
        "web-research",
        "academic",
        "market-research",
        "security-review",
        "vulnerability",
        "auth",
        "skill-authoring",
        "mcp",
        "agent-operations",
        "ai-engineering",
        "persona",
        "investing",
        "financial-analysis",
        "accounting-tax",
        "speech",
        "music",
        "sound",
        "contracts",
        "compliance",
        "legal-work",
        "health",
        "lifestyle",
        "business-ops",
        "misc",
        "finance",
        "legal",
        "audio"
      ],
      "title": "Subcategory",
      "type": "string"
    }
  },
  "properties": {
    "bootstrappedOn": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bootstrappedon"
    },
    "repositories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SiteRepository"
      },
      "title": "Repositories",
      "type": "array"
    },
    "schemaVersion": {
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "skills": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SiteSkill"
      },
      "title": "Skills",
      "type": "array"
    }
  },
  "title": "SiteData",
  "type": "object"
}
